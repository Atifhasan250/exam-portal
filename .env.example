MONGO_URI=
ADMIN_USERNAME=
# Local development only. Use ADMIN_PASSWORD_HASH in production.
# Generate with:
# node -e "const crypto=require('crypto'); const password=process.argv[1]; const salt=crypto.randomBytes(16).toString('hex'); const hash=crypto.scryptSync(password,salt,64).toString('hex'); console.log(`scrypt:${salt}:${hash}`)" "your-admin-password"
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
JWT_SECRET=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Production canonical domain. In Vercel production, keep this set exactly to:
NEXT_PUBLIC_SITE_URL=https://irz.atifhasan.com
# Local-only fallback. Do not set this to the Vercel deployment URL in production.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Upstash Redis — persistent rate limiting (required for production)
# Get these from https://console.upstash.com → create a Redis database → REST API tab
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional second Redis for cache/temporary UX data. If blank, these use the primary Redis above.
# Used for public page/resource cache, AI response cache, and 24h AI chat history.
# Do not use it for quota/rate-limit/provider counters.
UPSTASH_REDIS_CACHE_REST_URL=
UPSTASH_REDIS_CACHE_REST_TOKEN=

# Optional. Set a different value per deployment only if you need to override
# the automatic cache namespace derived from NODE_ENV/VERCEL_ENV and MONGO_URI.
CACHE_NAMESPACE=

SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=


YOUTUBE_API_KEY=
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=

# Resource AI doubt solver
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_MODEL_1=gemini-3.5-flash
GEMINI_MODEL_2=gemini-3.5-flash
GEMINI_MODEL_3=gemini-3.5-flash
GEMINI_MODEL_4=gemini-3.5-flash
GEMINI_MODEL_5=gemini-3.5-flash
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=
OPENROUTER_API_KEY_5=
OPENROUTER_MODEL_1=openrouter/free
OPENROUTER_MODEL_2=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_MODEL_3=google/gemma-4-31b-it:free
OPENROUTER_MODEL_4=google/gemma-4-26b-a4b-it:free
OPENROUTER_MODEL_5=nvidia/nemotron-nano-12b-v2-vl:free
AI_CHAT_DAILY_LIMIT=10
AI_CHAT_MAX_MESSAGE_CHARS=150
AI_CHAT_MAX_OUTPUT_TOKENS=2800
AI_CHAT_CACHE_TTL_SECONDS=86400
AI_CHAT_HISTORY_TTL_SECONDS=86400
AI_CHAT_USER_MINUTE_LIMIT=2
AI_CHAT_PROVIDER_RPM_LIMIT=15
AI_CHAT_RETRY_ATTEMPTS=3
AI_CHAT_RETRY_BASE_DELAY_MS=1000

# Web Push / PWA reminders
# Generate VAPID keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=itresourcezone@gmail.com
CRON_SECRET=


# Clerk custom domain Frontend API URL (only needed when using a custom domain in Clerk dashboard)
# e.g. https://clerk.yourdomain.com
NEXT_PUBLIC_CLERK_FRONTEND_API_URL=
